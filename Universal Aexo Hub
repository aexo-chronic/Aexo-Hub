section(visualsPage, "Player Highlights")

local function removeHighlight(player)
    local existing = highlights[player]

    if existing then
        existing:Destroy()
        highlights[player] = nil
    end
end

local function applyHighlight(player)
    if player == Player then return end

    local targetCharacter = player.Character
    if not targetCharacter then return end

    if not settings.Highlighter then
        removeHighlight(player)
        return
    end

    local color = HIGHLIGHT_COLORS[settings.HighlighterColor]
        or HIGHLIGHT_COLORS.Blue

    local highlight = highlights[player]

    if not highlight or not highlight.Parent then
        highlight = Instance.new("Highlight")
        highlight.Name = "AexoPlayerHighlight"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = targetCharacter
        highlights[player] = highlight
    end

    highlight.Adornee = targetCharacter
    highlight.OutlineColor = color
    highlight.FillColor = color
    highlight.OutlineTransparency = 0.05
    highlight.FillTransparency = 0.72
    highlight.Enabled = true
end

local function refreshHighlights()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player then
            applyHighlight(player)
        end
    end
end

makeToggle(
    visualsPage,
    "Highlighter",
    false,
    function(value)
        settings.Highlighter = value

        if value then
            refreshHighlights()
        else
            for player in pairs(highlights) do
                removeHighlight(player)
            end
        end
    end
)

makeSelector(
    visualsPage,
    "Highlight Color",
    {"Black", "White", "Grey", "Red", "Green", "Blue", "Yellow"},
    "Blue",
