    removeHighlight(player)
end))

--==================================================
-- MOVEMENT LOOP
--==================================================

local lastSpinTime = os.clock()

addConnection(RunService.Stepped:Connect(function()
    if not character or not character.Parent then return end
    if not humanoid or humanoid.Health <= 0 then return end

    -- Reapply selected speed.
    if settings.ConstantChange and not settings.FreezeMovement then
        humanoid.WalkSpeed = settings.Speed
    elseif settings.Sprint and not settings.FreezeMovement then
        humanoid.WalkSpeed = math.max(settings.Speed, 28)
    end

    if settings.FreezeMovement then
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
    elseif settings.JumpBoost then
        humanoid.JumpPower = settings.Jump
    end

    -- Noclip: disable collisions on character parts while enabled.
    -- This is a basic local implementation; it may affect floor collisions.
    if settings.Noclip then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if originalCollisions[part] == nil then
                    originalCollisions[part] = part.CanCollide
                end

                part.CanCollide = false
            end
        end
    else
        for part, original in pairs(originalCollisions) do
            if part and part.Parent then
                part.CanCollide = original
            end

            originalCollisions[part] = nil
        end
    end

    -- Basic air control: preserve vertical velocity while controlling
    -- horizontal movement during airborne states.
    if settings.AirControl and rootPart then
        local state = humanoid:GetState()

        if state == Enum.HumanoidStateType.Freefall
            or state == Enum.HumanoidStateType.Jumping then

            local moveDirection = humanoid.MoveDirection
            local currentVelocity = rootPart.AssemblyLinearVelocity

            rootPart.AssemblyLinearVelocity = Vector3.new(
                moveDirection.X * math.max(settings.Speed, 16),
                currentVelocity.Y,
                moveDirection.Z * math.max(settings.Speed, 16)
            )
        end
    end

    -- Spin around the vertical axis.
    if settings.Spin and rootPart and not settings.FreezeMovement then
        local direction = settings.SpinDirection == "Clockwise" and 1 or -1
        local deltaTime = math.min(os.clock() - lastSpinTime, 0.1)

        rootPart.CFrame = rootPart.CFrame
            * CFrame.Angles(0, math.rad(settings.SpinSpeed * 45 * direction) * deltaTime, 0)
    end

    lastSpinTime = os.clock()
end))

