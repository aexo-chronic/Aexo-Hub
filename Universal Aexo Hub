local function saveCharacter(characterModel)
    character = characterModel
    humanoid = characterModel:WaitForChild("Humanoid")
    rootPart = characterModel:WaitForChild("HumanoidRootPart")

    originalMovement.WalkSpeed = humanoid.WalkSpeed
    originalMovement.JumpPower = humanoid.JumpPower

    if settings.FreezeMovement then
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
    else
        humanoid.WalkSpeed = settings.Speed
        humanoid.JumpPower = settings.Jump
    end

    task.wait(0.2)

    if settings.Highlighter then
        refreshHighlights()
    end
end

if Player.Character then
    task.spawn(saveCharacter, Player.Character)
end

addConnection(Player.CharacterAdded:Connect(function(newCharacter)
    task.spawn(saveCharacter, newCharacter)
end))

