local function makeToggle(parent, text, initial, callback, premium)
    local row = controlRow(parent, text, 46)

    local toggle = button(
        row,
        initial and "ON" or "OFF",
        UDim2.fromOffset(66, 30),
        UDim2.new(1, -76, 0.5, -15)
    )

    toggle.TextSize = 12

    local state = initial

    local function paint()
        toggle.Text = state and "ON" or "OFF"
        toggle.BackgroundColor3 = state and COLORS.Blue or COLORS.PanelLight
        toggle.TextColor3 = state and COLORS.Background or COLORS.Muted
    end

    paint()

    toggle.MouseButton1Click:Connect(function()
        if premium and not isPremium then
            premiumNotice()
            return
        end

        state = not state
        paint()

        callback(state)
    end)

    return {
        Get = function()
            return state
        end,

        Set = function(value, fireCallback)
            state = value
            paint()

            if fireCallback then
                callback(state)
            end
        end,
    }
end

local function makeSlider(parent, text, minimum, maximum, initial, callback, premium)
    local row = controlRow(parent, text, 65)

    local valueLabel = label(
        row,
        tostring(initial),
        UDim2.fromOffset(45, 24),
        UDim2.new(1, -55, 0, 3),
        12,
        COLORS.BlueLight
    )
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = make("Frame", {
        Size = UDim2.new(1, -24, 0, 7),
        Position = UDim2.fromOffset(12, 43),
        BackgroundColor3 = COLORS.PanelLight,
        BorderSizePixel = 0,
    }, row)
    round(track, 6)

    local fill = make("Frame", {
        Size = UDim2.new((initial - minimum) / (maximum - minimum), 0, 1, 0),
        BackgroundColor3 = COLORS.Blue,
        BorderSizePixel = 0,
    }, track)
    round(fill, 6)

    local knob = make("Frame", {
        Size = UDim2.fromOffset(13, 13),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((initial - minimum) / (maximum - minimum), 0, 0.5, 0),
        BackgroundColor3 = COLORS.BlueLight,
        BorderSizePixel = 0,
    }, track)
    round(knob, 10)

    local value = initial
    local sliding = false

    local function setValue(newValue, fireCallback)
        value = math.clamp(math.floor(newValue + 0.5), minimum, maximum)

        local alpha = (value - minimum) / (maximum - minimum)

        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(value)

        if fireCallback then
            callback(value)
        end
    end

    local function updateFromInput(input)
        local alpha = math.clamp(
            (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
            0,
            1
        )

        setValue(minimum + alpha * (maximum - minimum), true)
    end

    track.InputBegan:Connect(function(input)
        if premium and not isPremium then
            premiumNotice()
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            sliding = true
            updateFromInput(input)
        end
    end)

    knob.InputBegan:Connect(function(input)
        if premium and not isPremium then
            premiumNotice()
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            sliding = true
            updateFromInput(input)
        end
    end)

    addConnection(UIS.InputChanged:Connect(function(input)
        if not sliding then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input)
        end
    end))

    addConnection(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end))

    return {
        Get = function()
            return value
        end,

        Set = function(newValue, fireCallback)
            setValue(newValue, fireCallback)
        end,
    }
end

local function makeSelector(parent, text, options, initial, callback, premium)
    local row = controlRow(parent, text, 48)

    local currentIndex = table.find(options, initial) or 1

    local choice = button(
        row,
        options[currentIndex],
        UDim2.fromOffset(116, 30),
        UDim2.new(1, -126, 0.5, -15)
    )

    choice.TextSize = 11

    local function paint()
        choice.Text = options[currentIndex]
    end

    choice.MouseButton1Click:Connect(function()
        if premium and not isPremium then
            premiumNotice()
            return
        end

        currentIndex = currentIndex % #options + 1
        paint()
        callback(options[currentIndex])
    end)

    paint()

    return {
        Get = function()
            return options[currentIndex]
        end,

        Set = function(value, fireCallback)
            local index = table.find(options, value)

            if index then
                currentIndex = index
                paint()

                if fireCallback then
                    callback(options[currentIndex])
                end
            end
        end,
    }
end

